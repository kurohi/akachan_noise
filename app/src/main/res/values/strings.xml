    <!-- Onboarding -->
    <string name="onboarding_private_title">Nothing leaves this phone</string>
    <string name="onboarding_private_body">Akachan Noise has no internet permission at all. No accounts, no ads, no analytics — your mixes and recordings stay on your device.</string>
    <string name="onboarding_safe_title">Kind to tiny ears</string>
    <string name="onboarding_safe_body">Keep the phone as far from your baby as practical, use the lowest volume that works, and let the timer end the night. Every change fades gently so nothing startles.</string>
    <string name="onboarding_start">Start with the womb</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_skip">Skip</string>

    <!-- Safety -->
    <string name="safety_intro">Sound can help a baby settle, but how you play it matters.</string>
    <string name="safety_distance_title">Keep some distance</string>
    <string name="safety_distance_body">Put the phone or speaker across the room, not in the cot. As far away as practical is the goal.</string>
    <string name="safety_volume_title">As quiet as works</string>
    <string name="safety_volume_body">Start lower than you think you need and raise it only if your baby is still unsettled. Prolonged loud sound is not good for anyone.</string>
    <string name="safety_timer_title">Let it end</string>
    <string name="safety_timer_body">The timer is on by default. Sound all night is rarely needed; once your baby is asleep, quieter is better.</string>
    <string name="safety_limits_title">What this app cannot do</string>
    <string name="safety_limits_body">Phones cannot measure how loud the sound actually is in the room. Treat the volume slider as guidance, trust your ears, and follow your health visitor\'s advice. This app is not a medical device or a baby monitor.</string>

    <!-- Privacy -->
    <string name="privacy_short">Akachan Noise is built so your data stays yours.</string>
    <string name="privacy_no_internet_title">No internet access</string>
    <string name="privacy_no_internet_body">The app does not ask for the internet permission, so it cannot send anything anywhere. A build check fails if that ever changes.</string>
    <string name="privacy_local_title">Everything stays on the device</string>
    <string name="privacy_local_body">Mixes, favourites and settings live in the app\'s private storage. Cloud backup is off. You can export a file yourself if you want a copy.</string>
    <string name="privacy_mic_title">The microphone is opt-in</string>
    <string name="privacy_mic_body">The microphone is used only for the optional cry-activated restart and for recording your own sounds. Audio is analysed in memory and never stored or sent unless you save it yourself.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Playback in the background, and optionally notifications. No location, no contacts, no storage access — files are only opened through the system file picker.</string>
</resources>
