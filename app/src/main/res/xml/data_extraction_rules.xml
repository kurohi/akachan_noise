<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- No cloud backup: nothing leaves the device. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <!-- Device-to-device transfer is allowed so parents can move their mixes
         to a new phone with a cable. -->
    <device-transfer>
        <include domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
